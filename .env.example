# Mailchimp Marketing API (server-only — add to Vercel Environment Variables)
# Audience ID: Mailchimp → Audience → Settings → Audience name and defaults
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# Google Analytics 4 (public — Measurement ID G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Gold4Life500 sticky banner — optional overrides (Pacific Time)
# NEXT_PUBLIC_GOLD4LIFE500_PROMO=false
# NEXT_PUBLIC_GOLD4LIFE500_PROMO_END=2026-06-29
