# Klaviyo private API (server-only — add to Vercel Environment Variables)
# The private key needs Profiles and Subscriptions write access.
KLAVIYO_API_KEY=
KLAVIYO_LIST_ID=

# Google Analytics 4 (public — Measurement ID G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Gold4Life500 sticky banner — optional overrides (Pacific Time)
# NEXT_PUBLIC_GOLD4LIFE500_PROMO=false
# NEXT_PUBLIC_GOLD4LIFE500_PROMO_END=2026-06-29

# Minelab GM1000 $800-off banner (enabled by default)
# NEXT_PUBLIC_MINELAB_GM1000_PROMO=false
